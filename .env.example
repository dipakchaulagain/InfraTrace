# Single .env for both Docker Compose and local (non-Docker) development.
# Nothing here is required — every value has a safe default. Copy only if
# you want to override something: cp .env.example .env
# Full reference and rationale for each variable: see README "Configuration reference".

# -----------------------------------------------------------------------
# App
# -----------------------------------------------------------------------
# development | production — affects log formatting only
APP_ENV=production
LOG_LEVEL=INFO
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
# See README — POSTGRES_PASSWORD only applies on first init.
POSTGRES_DB=infratrace
POSTGRES_USER=infratrace_app
POSTGRES_PASSWORD=changeme

# Local (non-Docker) dev only — see README "Local Development".
# DATABASE_URL=postgresql://infratrace_app:changeme@localhost:5432/infratrace

# -----------------------------------------------------------------------
# Session / JWT
# -----------------------------------------------------------------------
# JWT signing + connector-credential encryption key. Set a real one before
# exposing beyond localhost: openssl rand -hex 32 — see README.
SECRET_KEY=

ALGORITHM=HS256
# JWT lifetime (minutes) — see README.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Idle timeout (minutes) — see README.
SESSION_IDLE_TIMEOUT_MINUTES=30

# -----------------------------------------------------------------------
# Default admin account
# -----------------------------------------------------------------------
# Seeded once on first boot — see README.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@infratrace.local
# Blank = auto-generated, printed once to `docker compose logs api`.
DEFAULT_ADMIN_PASSWORD=

# -----------------------------------------------------------------------
# DB Backup & Restore
# -----------------------------------------------------------------------
# Docker-only default; see README "Database Backup & Restore".
# BACKUP_DIR=./backup

# -----------------------------------------------------------------------
# Image tag (registry-pull deploys only)
# -----------------------------------------------------------------------
# Pin a release, e.g. IMAGE_TAG=v1.3.0. Defaults to "latest" — see README.
# IMAGE_TAG=latest

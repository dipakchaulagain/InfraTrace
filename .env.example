# Single .env for both the Docker Compose flow and local (non-Docker)
# development — nothing here is required to start the stack; every value
# already has the same safe default baked into docker-compose.yml, so
# `docker-compose up` works with no .env at all. Copy this file only if you
# want to override something.
#
#   cp .env.example .env
#
# VMware/Nutanix connector credentials and sync-engine tuning are NOT
# configured here — they're admin-only, set via the web UI at
# Admin -> Settings (stored encrypted in the database) after first login.

# -----------------------------------------------------------------------
# App
# -----------------------------------------------------------------------
# development | production — affects log formatting only
APP_ENV=production
LOG_LEVEL=INFO
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
# Used by docker-compose to configure the db container AND to assemble
# DATABASE_URL for api/scheduler (host is always "db" inside Docker).
# IMPORTANT: Postgres only applies POSTGRES_PASSWORD when it initializes a
# brand-new data volume — set this before the first `docker-compose up`,
# not after (changing it later requires ALTER ROLE inside the db container
# too, or the api/scheduler containers will fail to authenticate).
POSTGRES_DB=infratrace
POSTGRES_USER=infratrace_app
POSTGRES_PASSWORD=changeme

# Only read when running the backend directly (no Docker) — see README's
# "Local Development" section. Docker Compose ignores this and always
# assembles its own DATABASE_URL from the POSTGRES_* values above.
# DATABASE_URL=postgresql://infratrace_app:changeme@localhost:5432/infratrace

# -----------------------------------------------------------------------
# Session / JWT
# -----------------------------------------------------------------------
# JWT signing key — also used to encrypt connector passwords stored in the
# database. Defaults to an insecure placeholder; set a real one before
# exposing this beyond localhost. Generate with: openssl rand -hex 32
# Changing this after connectors are already configured breaks decryption
# of their stored passwords — you'd need to re-enter them via Settings.
SECRET_KEY=

ALGORITHM=HS256
# JWT lifetime (minutes). The session is also revocable server-side before
# this via logout / idle timeout below — this is just the outer cap.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Idle timeout (minutes) before a session is force-revoked. Also
# admin-adjustable at runtime via Settings -> General; this is only the
# fallback default used until an admin saves a value there.
SESSION_IDLE_TIMEOUT_MINUTES=30

# -----------------------------------------------------------------------
# Default admin account
# -----------------------------------------------------------------------
# Created once by seed.py on first boot (skipped if this username already
# exists — safe to leave these as-is on every subsequent restart). Change
# the password via Admin -> Users immediately after first login regardless.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@infratrace.local
# Blank = auto-generated, printed once to `docker compose logs api`.
DEFAULT_ADMIN_PASSWORD=

# -----------------------------------------------------------------------
# DB Backup & Restore
# -----------------------------------------------------------------------
# Docker-only — defaults to /app/backups, the path docker-compose.yml
# bind-mounts to ./backup on the host. Only set this if running outside
# Docker, pointed at a real local folder.
# BACKUP_DIR=./backup

# -----------------------------------------------------------------------
# Image tag (registry-pull deploys only)
# -----------------------------------------------------------------------
# Pin a release, e.g. IMAGE_TAG=v1.3.0. Defaults to "latest". See README.
# IMAGE_TAG=latest

# Optional — used by `docker-compose up` for variable substitution.
# Nothing here is required to start the stack; every value already has a
# safe default in docker-compose.yml. Copy to .env only if you want to
# override something before first boot.
#
#   cp .env.example .env

# JWT signing key — also used to encrypt connector passwords stored in the
# database. Defaults to an insecure placeholder; set a real one before
# exposing this beyond localhost.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# development | production — affects log formatting only
APP_ENV=production
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost

# -----------------------------------------------------------------------
# VMware / Nutanix connector credentials — OPTIONAL.
# Skip these and configure connectors after first login via
# Admin -> Settings instead; credentials entered there are encrypted and
# stored in the database, and take precedence over these variables.
# Only set these if you want a connector already configured at first boot.
# -----------------------------------------------------------------------
# VCENTER_HOST=vcenter.example.com
# VCENTER_USER=svc-readonly@vsphere.local
# VCENTER_PASSWORD=
# VCENTER_PORT=443
# VCENTER_INSECURE=false

# NUTANIX_BASE_URL=https://cluster-ip:9440/PrismGateway/services/rest/v2.0
# NUTANIX_USER=svc-readonly
# NUTANIX_PASSWORD=
# NUTANIX_INSECURE=false

# Sync engine tuning — also overridable at runtime via Admin -> Settings
# SYNC_PAGE_SIZE=100
# SYNC_RETRY_MAX_ATTEMPTS=3

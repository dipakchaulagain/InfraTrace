# Local development only (running the backend outside Docker).
# Copy to backend/.env and fill in real values — never commit backend/.env.
#
#   cp .env.example .env

# ---- Database ----
# Point at your own Postgres instance, e.g. the one-off container from the
# README's "Local Development" section.
DATABASE_URL=postgresql://infratrace_app:changeme@localhost:5432/infratrace

# ---- JWT ----
# Also used to encrypt connector passwords stored in the database.
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------
# VMware / Nutanix connector credentials — OPTIONAL.
# Configure connectors after first login via Admin -> Settings instead if
# you'd rather not put them in a file; that path stores them encrypted in
# the database and takes precedence over these variables.
# -----------------------------------------------------------------------
# VCENTER_HOST=vcenter.example.com
# VCENTER_USER=svc-readonly@vsphere.local
# VCENTER_PASSWORD=
# VCENTER_PORT=443
# VCENTER_INSECURE=false

# NUTANIX_BASE_URL=https://cluster-ip:9440/PrismGateway/services/rest/v2.0
# NUTANIX_USER=svc-readonly
# NUTANIX_PASSWORD=
# NUTANIX_INSECURE=false
